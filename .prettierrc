{
  "$schema": "https://json.schemastore.org/prettierrc",
  "semi": true,
  "singleQuote": false,
  "tabWidth": 2,
  "trailingComma": "all",
  "printWidth": 100,
  "bracketSpacing": true,
  "arrowParens": "always",
  "endOfLine": "lf",
  "plugins": ["@ianvs/prettier-plugin-sort-imports", "prettier-plugin-tailwindcss"],
  "importOrder": [
    "^react$",
    "<THIRD_PARTY_MODULES>",
    "",
    "^@core/(.*)$",
    "^@shared/(.*)$",
    "^@features/(.*)$",
    "^@workers/(.*)$",
    "",
    "<TYPES>^react$",
    "<TYPES>",
    "<TYPES>^@core/(.*)$",
    "<TYPES>^@shared/(.*)$",
    "<TYPES>^@features/(.*)$",
    "<TYPES>^@workers/(.*)$"
  ],
  "importOrderParserPlugins": ["typescript", "jsx", "decorators-legacy"],
  "importOrderTypeScriptVersion": "5.0.0",
  "tailwindFunctions": ["clsx", "cn", "cva"]
}
